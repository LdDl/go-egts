# Credentials and vhost initialize a new broker data volume.
RABBITMQ_BIND_HOST_MONITORING=127.0.0.1
RABBITMQ_PORT_MONITORING=5672
RABBITMQ_MANAGEMENT_PORT_MONITORING=15672
RABBITMQ_USER_MONITORING=egts_monitoring
RABBITMQ_PASSWORD_MONITORING=egts_monitoring
RABBITMQ_VHOST_MONITORING=egts

RABBITMQ_BIND_HOST_BACKUP=127.0.0.1
RABBITMQ_PORT_BACKUP=5673
RABBITMQ_MANAGEMENT_PORT_BACKUP=15673
RABBITMQ_USER_BACKUP=egts_backup
RABBITMQ_PASSWORD_BACKUP=egts_backup
RABBITMQ_VHOST_BACKUP=egts

# Password-only AUTH uses the default user.
VALKEY_BIND_HOST_MONITORING=127.0.0.1
VALKEY_PORT_MONITORING=6379
VALKEY_PASSWORD_MONITORING=egts_monitoring
# Keep below the container memory limit to leave room for persistence and buffers.
VALKEY_MAXMEMORY_MONITORING=128mb

# Named-user AUTH uses this ACL user; the default user is disabled.
VALKEY_BIND_HOST_BACKUP=127.0.0.1
VALKEY_PORT_BACKUP=6380
VALKEY_USERNAME_BACKUP=egts_backup
VALKEY_PASSWORD_BACKUP=egts_backup
VALKEY_MAXMEMORY_BACKUP=128mb
